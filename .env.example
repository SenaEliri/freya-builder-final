# Copy to env.sh (git-ignored) and `source env.sh` before any live step. Placeholders only: never commit real values.
export FREYA_API_KEY=fak_your_key_here                       # Freya workspace API key (workspace settings > API keys)
export FREYA_API_URL=https://staging-app.freyavoice.ai       # event platform
export FREYA_WORKSPACE_ID=your-workspace-uuid                # optional: skips the workspace lookup
export FREYA_BANK_TEAM_KEY=pick-a-secret-of-16-or-more-chars # your team's practice-bank key, the same one every time
